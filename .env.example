# Copie este arquivo para .env e preencha. O .env nunca é versionado.

# --- Modelo de linguagem (LLM) -------------------------------------------------
# Sem nenhuma chave, o GenIA funciona no modo extrativo (responde só com frases do relatório).
# Para usar um LLM, preencha UMA das chaves abaixo (ambas têm plano gratuito):
GROQ_API_KEY=
GEMINI_API_KEY=

# Opcional: força um provedor (groq, gemini, ollama, extrativo) e troca o modelo padrão.
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0

# Opcional: qualquer outro provedor com API compatível com a da OpenAI.
# LLM_BASE_URL=
# LLM_API_KEY=

# --- Registro de auditoria ----------------------------------------------------
# Opcional: Postgres para o registro de auditoria. Sem isso, usa um arquivo SQLite em var/.
# No deploy na Vercel, a integração com o Neon define esta variável sozinha.
# DATABASE_URL=

# --- Privacidade e operação ----------------------------------------------------
# Sal do pseudônimo de sessão. Em produção, use um valor longo e secreto.
GENIA_SAL=troque-este-valor
# Token exigido para reexecutar o pipeline pela página de monitoramento.
GENIA_TOKEN_OPERADOR=
# Dias de retenção do registro de auditoria.
GENIA_RETENCAO_DIAS=30
